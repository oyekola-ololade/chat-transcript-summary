              "value": 1500
            },
            {
              "name": "messages",
              "value": "[{\"role\":\"user\",\"content\":\"Summarize this support chat. Provide: issue, resolution, customer satisfaction (1-10), action items. Transcript: {{ $json.transcript }}\"}]"
            }
          ]
        }
      }
    },
    {
